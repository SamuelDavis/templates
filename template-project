#!/bin/bash

set -euo pipefail

die() {
  printf "%s\n" "$1" >&2
  exit 1
}

download_once() {
  local url="$1" archive="$2"
  [ -f "$archive" ] && return
  curl --fail --location "$url" --output "$archive.part"
  mv "$archive.part" "$archive"
}

extract_root() {
  local archive="$1" output="$2" staging
  staging="$(mktemp --directory)"
  trap "rm -rf '$staging'" EXIT
  unzip -q "$archive" -d "$staging"
  mv "$staging"/* "$output"
}

init_repo() {
  local dir="$1" message="$2"
  git -C "$dir" init
  git -C "$dir" add .
  git -C "$dir" commit -m "$message"
}

[ "$#" -eq 2 ] || die "usage: $(basename "$0") <template-branch> <project-directory>"

branch="$1"
output="$2"
archive="/tmp/templates-${branch//\//-}.zip"

[ -e "$output" ] && die "$output already exists"

download_once "https://github.com/SamuelDavis/templates/archive/refs/heads/$branch.zip" "$archive"
extract_root "$archive" "$output"
init_repo "$output" "initialize with $branch"
